{
  "name": "@up-travel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev --config ../../wrangler.jsonc",
    "dev:host": "node -e \"require('node:fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev --config ../../wrangler.jsonc --ip 0.0.0.0",
    "deploy": "wrangler deploy --config ../../wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@up-travel/shared": "workspace:*",
    "hono": "4.6.5",
    "drizzle-orm": "0.36.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "4.20260613.1",
    "vitest": "2.1.2",
    "wrangler": "4.100.0"
  }
}

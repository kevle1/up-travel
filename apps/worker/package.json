{
  "name": "@up-travel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply up-travel --local",
    "db:migrate:remote": "wrangler d1 migrations apply up-travel --remote"
  },
  "dependencies": {
    "@up-travel/shared": "workspace:*",
    "hono": "4.6.5",
    "drizzle-orm": "0.34.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.5.18",
    "@cloudflare/workers-types": "4.20241022.0",
    "drizzle-kit": "0.26.2",
    "vitest": "2.1.2",
    "wrangler": "3.81.0"
  }
}

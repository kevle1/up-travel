{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "up-travel-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "up-travel",
      "database_id": "PLACEHOLDER_REPLACED_AT_DEPLOY",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "PLACEHOLDER_REPLACED_AT_DEPLOY"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "UP_API_BASE": "https://api.up.com.au/api/v1"
  },
  "dev": {
    "port": 8787
  }
}
